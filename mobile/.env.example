# Use your PC's LAN IP (not localhost) when testing on a physical device with Expo Go.
# Must match the IP printed when you start the backend (`npm run dev`).
# Example: http://192.168.161.177:4000
EXPO_PUBLIC_API_BASE_URL=http://192.168.161.177:4000

# Set to false to disable API logs in Metro / device console
EXPO_PUBLIC_DEBUG_API=true
