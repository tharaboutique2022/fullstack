{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://fullstack-kzxl.onrender.com",
        "EXPO_PUBLIC_DEBUG_API": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://fullstack-kzxl.onrender.com",
        "EXPO_PUBLIC_DEBUG_API": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}